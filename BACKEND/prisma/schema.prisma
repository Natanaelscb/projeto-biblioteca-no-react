generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}
model Usuario {
    id      Int @id @default(autoincrement())
    nome    String
    matricula   String @unique
    email   String @unique

    emprestimos Emprestimo[]
}
model Livro {
    id                      Int     @id @default(autoincrement())
    titulo                  String
    autor                   String
    isbn                    String @unique
    categoria               String?
    anoPublicado            Int?
    quantidade              Int
    quantidadeDisponivel    Int

    emprestimos             Emprestimo[]

}
model Emprestimo {
    id          Int @id @default(autoincrement())

    usuarioId   Int
    livroId     Int

    usuario     Usuario @relation(fields: [usuarioId], references: [id])
    livro       Livro @relation(fields: [livroId], references: [id])
}